<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#050505">
<title>IRONLOG</title>
<style>
*{box-sizing:border-box}html,body{margin:0;background:#050505;color:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","Segoe UI",sans-serif}
body{max-width:560px;margin:auto;padding:0 16px 100px}
header{padding:22px 0 14px;display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:800;letter-spacing:.16em;font-size:14px}.date{font-size:12px;color:#777}
h1{font-size:30px;line-height:1.05;margin:12px 0 6px}.muted{color:#777;font-size:13px}
.card{background:#0d0d0d;border:1px solid #1c1c1c;border-radius:18px;padding:16px;margin:12px 0}
.tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:14px 0}
button{font:inherit;border:0;color:#eee;background:#151515;border:1px solid #222;border-radius:12px;padding:11px 10px}
button:active{transform:scale(.98)}button.primary{background:#f2f2f2;color:#050505;border-color:#f2f2f2;font-weight:700}
button.small{padding:8px 10px;font-size:12px}
.daynav{display:flex;gap:7px;overflow:auto;margin:10px 0 16px}.daynav button{white-space:nowrap}
.daynav button.active{background:#f2f2f2;color:#050505}
.exercise{padding:15px 0;border-top:1px solid #1d1d1d}.exercise:first-child{border-top:0}
.exhead{display:flex;justify-content:space-between;gap:10px}.exname{font-weight:700}.prescription{font-size:12px;color:#777;margin-top:4px}
.last{font-size:11px;color:#888;margin-top:6px}
.sets{display:grid;grid-template-columns:34px 1fr 1fr 1fr 72px;gap:6px;align-items:center;margin-top:12px}
.sets span{font-size:11px;color:#666;text-align:center}.sets input{width:100%;background:#080808;border:1px solid #242424;color:#fff;border-radius:9px;padding:9px 6px;text-align:center;font-size:13px}
.sets .head{color:#666;font-size:10px}.check{padding:9px 0;border-radius:9px}
.check.done{background:#f2f2f2;color:#050505}
.row{display:flex;gap:8px;align-items:center}.between{justify-content:space-between}
.statgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{background:#101010;border-radius:12px;padding:12px}.stat b{font-size:18px;display:block}.stat small{color:#666}
input.weight{font-size:28px;background:transparent;border:0;border-bottom:1px solid #333;color:#fff;width:120px;outline:none}
.nav{position:fixed;bottom:0;left:0;right:0;background:rgba(5,5,5,.96);border-top:1px solid #1b1b1b;padding:9px max(16px,calc((100vw - 560px)/2 + 16px));display:grid;grid-template-columns:repeat(3,1fr);gap:7px;z-index:10}
.nav button{background:transparent;border:0;color:#777}.nav button.active{color:#fff}
canvas{width:100%;height:180px;background:#090909;border-radius:12px}
.hidden{display:none}.danger{color:#aaa}
@media(min-width:600px){body{padding-bottom:30px}.nav{position:static;margin:20px auto;max-width:560px;border:0;padding:0}.nav button{border:1px solid #1c1c1c;border-radius:12px}}
</style>
</head>
<body>
<header><div class="logo">IRONLOG</div><div class="date" id="today"></div></header>

<section id="workoutView">
  <div id="home"></div>
</section>

<section id="progressView" class="hidden">
  <h1>Progress</h1>
  <p class="muted">Your logged bodyweight and training history.</p>
  <div class="card">
    <div class="between row"><b>Bodyweight</b><button class="small" onclick="addWeight()">Log weight</button></div>
    <div style="margin:18px 0"><canvas id="chart" width="520" height="180"></canvas></div>
    <div id="weightHistory"></div>
  </div>
  <div class="card">
    <div class="between row"><b>Data</b><button class="small" onclick="exportData()">Export</button></div>
    <p class="muted">Save a backup of your logs. You can import it again if you change phones.</p>
    <input id="importFile" type="file" accept=".json" style="display:none" onchange="importData(event)">
    <button class="small" onclick="document.getElementById('importFile').click()">Import backup</button>
    <button class="small danger" onclick="clearData()">Reset all data</button>
  </div>
</section>

<nav class="nav">
  <button id="navWorkout" class="active" onclick="showTab('workout')">Workout</button>
  <button id="navProgress" onclick="showTab('progress')">Progress</button>
  <button onclick="restTimer()">Timer</button>
</nav>

<script>
const program = {
Mon:{name:"Push A",focus:"Chest emphasis",ex:[
["Incline DB Press",3,"6–10"],["Flat Machine Chest Press",3,"8–12"],["Cable Fly",2,"10–15"],["Seated DB Shoulder Press",3,"6–10"],["Cable Lateral Raise",3,"12–20"],["Overhead Cable Triceps Extension",3,"10–15"],["Cable Pressdown",2,"10–15"]]},
Tue:{name:"Pull A",focus:"Back + biceps",ex:[
["Pull-ups",3,"6–10"],["Chest-Supported Row",3,"8–12"],["Lat Pulldown",2,"10–15"],["Cable Row",2,"8–12"],["Preacher Curl",3,"8–12"],["Bayesian Cable Curl",3,"10–15"],["Hammer Curl",2,"10–15"],["Reverse Wrist Curl",2,"15–20"],["Wrist Curl",2,"15–20"]]},
Wed:{name:"Legs A",focus:"Quad emphasis",ex:[
["Leg Press",3,"6–10"],["Bulgarian Split Squat",3,"8–12 / leg"],["Leg Extension",3,"10–15"],["Hamstring Curl",3,"10–15"],["Romanian Deadlift",2,"8–12"],["Standing Calf Raise",4,"8–15"],["Seated Calf Raise",2,"12–20"]]},
Thu:{name:"Push B",focus:"Chest + lateral delts",ex:[
["Flat Barbell / Smith Press",3,"6–10"],["Incline Machine Press",3,"8–12"],["Cable Fly",2,"12–15"],["Machine Shoulder Press",2,"8–12"],["Cable Lateral Raise",4,"12–20"],["Overhead Triceps Extension",3,"10–15"],["Single-Arm Cable Pressdown",2,"12–15"]]},
Fri:{name:"Pull B",focus:"Back + traps",ex:[
["Lat Pulldown / Weighted Pull-up",3,"6–10"],["Chest-Supported T-Bar Row",3,"8–12"],["One-Arm Cable Lat Row",2,"10–15"],["Straight-Arm Pulldown",2,"12–15"],["EZ-Bar Curl",3,"6–10"],["Incline DB Curl",3,"8–12"],["Cross-Body Hammer Curl",2,"10–15"],["DB / Cable Shrug",3,"10–15"],["Rear-Delt Fly",2,"15–20"]]},
Sat:{name:"Legs B + Shoulders",focus:"Legs + shoulders + traps",ex:[
["Leg Press",3,"8–12"],["Bulgarian Split Squat",2,"8–12 / leg"],["Hamstring Curl",3,"8–12"],["Leg Extension",2,"12–15"],["Seated Calf Raise",3,"10–20"],["Seated DB Shoulder Press",3,"8–12"],["Cable Lateral Raise",4,"12–20"],["Reverse Pec Deck",3,"12–20"],["DB / Cable Shrug",2,"10–15"]]},
Sun:{name:"Rest",focus:"Recovery",ex:[]}
};
const dayKeys=["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
const dayNames=["MON","TUE","WED","THU","FRI","SAT","SUN"];
let data=JSON.parse(localStorage.getItem("ironlog")||'{"logs":{},"weights":[]}');

function save(){localStorage.setItem("ironlog",JSON.stringify(data))}
function iso(){return new Date().toISOString().slice(0,10)}
function dayKey(){return ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"][new Date().getDay()]}
let selected=dayKey();

function render(){
 document.getElementById("today").textContent=new Date().toLocaleDateString(undefined,{day:"2-digit",month:"short"});
 let p=program[selected], log=data.logs[iso()+"_"+selected]||{};
 let html=`<div class="daynav">${dayKeys.map((d,i)=>`<button class="${d===selected?'active':''}" onclick="selected='${d}';render()">${dayNames[i]}</button>`).join("")}</div>`;
 if(p.ex.length===0){
   html+=`<div class="card"><h1>Rest day</h1><p class="muted">Recovery is part of the program. Log your bodyweight and get ready for Monday.</p></div>`;
 } else {
   html+=`<h1>${p.name}</h1><p class="muted">${p.focus}</p>`;
   html+=`<div class="card"><div class="between row"><b>Today's bodyweight</b><button class="small" onclick="addWeight()">Log weight</button></div><div style="margin-top:10px"><span class="muted">kg</span> <input class="weight" id="bw" inputmode="decimal" placeholder="75.0" value="${latestWeight()}"></div></div>`;
   html+=`<div class="card">`;
   p.ex.forEach((e,ei)=>{
     let key=e[0], prev=findLast(key), sets=(log[key]||Array(e[1]).fill(null).map(()=>({w:"",r:"",rir:""})));
     html+=`<div class="exercise"><div class="exhead"><div><div class="exname">${key}</div><div class="prescription">${e[1]} sets · ${e[2]} reps</div>${prev?`<div class="last">Last: ${prev}</div>`:""}</div><button class="small" onclick="fillPrevious('${esc(key)}')">Last</button></div>`;
     html+=`<div class="sets"><span class="head">SET</span><span class="head">KG</span><span class="head">REPS</span><span class="head">RIR</span><span></span>`;
     for(let s=0;s<e[1];s++){let v=sets[s]||{w:"",r:"",rir:""};html+=`<span>${s+1}</span><input inputmode="decimal" value="${v.w||""}" placeholder="kg" onchange="setVal('${esc(key)}',${s},'w',this.value)"><input inputmode="numeric" value="${v.r||""}" placeholder="reps" onchange="setVal('${esc(key)}',${s},'r',this.value)"><input inputmode="numeric" value="${v.rir||""}" placeholder="RIR" onchange="setVal('${esc(key)}',${s},'rir',this.value)"><button class="check ${v.done?'done':''}" onclick="toggleSet('${esc(key)}',${s})">${v.done?'✓':'Done'}</button>`}
     html+=`</div></div>`;
   });
   html+=`</div><button class="primary" style="width:100%;margin-top:10px" onclick="finishWorkout()">Finish workout</button>`;
 }
 document.getElementById("home").innerHTML=html;
}
function esc(s){return s.replace(/'/g,"\\'")}
function key(){return iso()+"_"+selected}
function ensure(){if(!data.logs[key()])data.logs[key()]={}}
function setVal(ex,s,field,val){ensure();if(!data.logs[key()][ex])data.logs[key()][ex]=Array(program[selected].ex.find(x=>x[0]===ex)[1]).fill(null).map(()=>({w:"",r:"",rir:""}));data.logs[key()][ex][s][field]=val;save()}
function toggleSet(ex,s){ensure();let arr=data.logs[key()][ex];if(!arr){let n=program[selected].ex.find(x=>x[0]===ex)[1];arr=data.logs[key()][ex]=Array(n).fill(null).map(()=>({w:"",r:"",rir:""}))}arr[s].done=!arr[s].done;save();render()}
function findLast(ex){let entries=Object.entries(data.logs).filter(([k])=>k.split("_")[1]!==selected?false:true).sort().reverse();for(const [,l] of entries){if(l[ex]){let a=l[ex].filter(x=>x.w||x.r);if(a.length)return a.map(x=>`${x.w||"–"}kg × ${x.r||"–"}`).join(" · ")}}return ""}
function latestWeight(){return data.weights.length?data.weights[data.weights.length-1].weight:""}
function addWeight(){let v=prompt("Bodyweight (kg)",latestWeight());if(v!==null&&v.trim()!==""){data.weights.push({date:iso(),weight:Number(v)});data.weights.sort((a,b)=>a.date.localeCompare(b.date));save();render()}}
function fillPrevious(ex){let prev=findLastObj(ex);if(!prev)return alert("No previous log found.");ensure();let n=program[selected].ex.find(x=>x[0]===ex)[1];data.logs[key()][ex]=Array(n).fill(null).map((_,i)=>({...((prev[i]||prev[0])||{}),done:false}));save();render()}
function findLastObj(ex){let ks=Object.keys(data.logs).sort().reverse();for(const k of ks){if(k===key())continue;let l=data.logs[k];if(l&&l[ex])return l[ex]}return null}
function finishWorkout(){let done=0,total=0,l=data.logs[key()]||{};program[selected].ex.forEach(e=>(l[e[0]]||[]).forEach(s=>{total++;if(s.done)done++}));alert(`${done}/${total} sets completed. Keep the progression going.`)}
function showTab(t){document.getElementById("workoutView").classList.toggle("hidden",t!=="workout");document.getElementById("progressView").classList.toggle("hidden",t!=="progress");document.getElementById("navWorkout").classList.toggle("active",t==="workout");document.getElementById("navProgress").classList.toggle("active",t==="progress");if(t==="progress")renderProgress()}
function renderProgress(){let h=data.weights.map(x=>`<div class="between row" style="padding:8px 0;border-top:1px solid #1b1b1b"><span>${x.date}</span><b>${x.weight} kg</b></div>`).reverse().slice(0,14).join("");document.getElementById("weightHistory").innerHTML=h||'<span class="muted">No weight logged yet.</span>';drawChart()}
function drawChart(){let c=document.getElementById("chart"),ctx=c.getContext("2d"),w=c.width=c.clientWidth*2,h=c.height=360;c.style.height="180px";ctx.clearRect(0,0,w,h);let a=data.weights.slice(-14);if(a.length<2){ctx.fillStyle="#555";ctx.font="24px sans-serif";ctx.fillText("Log 2+ weights to see progress",20,170);return}let min=Math.min(...a.map(x=>x.weight))-1,max=Math.max(...a.map(x=>x.weight))+1;ctx.strokeStyle="#eee";ctx.lineWidth=4;ctx.beginPath();a.forEach((x,i)=>{let X=20+i*(w-40)/(a.length-1),Y=h-30-(x.weight-min)/(max-min)*(h-60);i?ctx.lineTo(X,Y):ctx.moveTo(X,Y)});ctx.stroke()}
function exportData(){let blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="ironlog-backup.json";a.click()}
function importData(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{data=JSON.parse(r.result);save();renderProgress()}catch{alert("Invalid backup file.")}};r.readAsText(f)}
function clearData(){if(confirm("Delete all workout and bodyweight data?")){data={logs:{},weights:[]};save();renderProgress()}}
let timer;
function restTimer(){let s=prompt("Rest timer in seconds","120");if(!s)return;let end=Date.now()+Number(s)*1000;let win=window.open("","_blank","width=300,height=250");if(!win){alert("Allow pop-ups for the timer.");return}win.document.write("<body style='background:#050505;color:white;font-family:-apple-system;text-align:center;padding-top:60px'><div id='t' style='font-size:60px;font-weight:800'></div><script>let e="+end+";setInterval(()=>{let s=Math.max(0,Math.ceil((e-Date.now())/1000));document.getElementById('t').textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0');if(!s)document.body.style.background='#222'},250)<\/script></body>")}
render();
</script>
</body>
</html>